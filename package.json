{
  "name": "compyle-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"next dev\"",
    "build": "next build",
    "start": "concurrently \"npm run server:prod\" \"next start\"",
    "lint": "eslint",
    "server:dev": "nodemon --exec ts-node src/app/api/server.ts",
    "server:prod": "node dist/server.js",
    "server:build": "tsc --project tsconfig.server.json"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "next": "16.0.1",
    "express": "^4.18.2",
    "mongoose": "^8.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@tailwindcss/postcss": "^4",
    "tailwindcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.0.1",
    "nodemon": "^3.0.2"
  }
}
